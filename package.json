{
  "name": "yingyou-studio",
  "productName": "影游剪辑台",
  "version": "0.6.0",
  "description": "用剪辑软件的方式做互动影游：剧本即剪辑表，素材可替换，一键导出游戏包；内置剧本 / 参考 / 提示词 / 图片 / 草稿 / 成片 / 台词审阅，框选修图和声音复刻",
  "main": "main.js",
  "author": "kindlingwd",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win zip --x64",
    "dist:dir": "electron-builder --win dir --x64"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "com.kindlingwd.yingyou-studio",
    "productName": "影游剪辑台",
    "artifactName": "YingyouStudio-${version}-win-x64.${ext}",
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "core.js",
      "voice-clone-service.js",
      "voice-refs-store.js",
      "voice_clone_worker.py",
      "renderer/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "zip"
      ],
      "executableName": "YingyouStudio",
      "signAndEditExecutable": false
    }
  }
}
